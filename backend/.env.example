# LLM provider: deepseek | openai | qwen | ollama
LLM_PROVIDER=deepseek

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / DashScope OpenAI-compatible endpoint
QWEN_API_KEY=
# Optional alias supported by the backend:
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Ollama remains supported, but is no longer the default.
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1

# Database
DATABASE_URL=sqlite+aiosqlite:///./chroma_db/value_eval_main.db

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# App
APP_RUNTIME_MODE=standalone
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
CORS_ALLOW_ORIGINS=

# Policy crawl
POLICY_CRAWL_ENABLED=false
POLICY_CRAWL_INTERVAL_MINUTES=360
POLICY_CRAWL_TIMEOUT_SECONDS=18
POLICY_CRAWL_MIN_RELEVANCE=0.35
POLICY_CRAWL_USER_AGENT=Mozilla/5.0

# Dimension matching
DIMENSION_MATCH_THRESHOLD=0.28
