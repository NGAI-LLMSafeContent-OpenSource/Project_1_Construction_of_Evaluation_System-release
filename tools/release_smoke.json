{
  "scope": "Fresh SQLite/Chroma initialization, runtime configuration tests, API and frontend production build/static HTTP; no live LLM or policy crawling",
  "requirements": "backend/requirements.txt",
  "commands": [
    {
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "cwd": "backend"
    },
    {
      "argv": [
        "npm",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "cwd": "frontend"
    },
    {
      "argv": [
        "npm",
        "test",
        "--",
        "--maxWorkers=1",
        "--minWorkers=1"
      ],
      "cwd": "frontend"
    },
    {
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "cwd": "frontend"
    }
  ],
  "servers": [
    {
      "argv": [
        "{python}",
        "-m",
        "uvicorn",
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "{port}"
      ],
      "cwd": "backend",
      "env": {
        "DATABASE_URL": "sqlite+aiosqlite:///{temp}/release.db",
        "CHROMA_PERSIST_DIR": "{temp}/chroma",
        "POLICY_CRAWL_ENABLED": "false",
        "ANONYMIZED_TELEMETRY": "False",
        "APP_RUNTIME_MODE": "standalone"
      },
      "ready": "/health",
      "checks": [
        {
          "path": "/health",
          "json_contains": {
            "status": "healthy"
          }
        },
        {
          "path": "/api/indicators/"
        },
        {
          "path": "/api/indicators/stats/summary"
        },
        {
          "path": "/api/indicators/framework"
        }
      ]
    },
    {
      "argv": [
        "{python}",
        "-m",
        "http.server",
        "{port}",
        "--bind",
        "127.0.0.1",
        "--directory",
        "frontend/dist"
      ],
      "checks": [
        {
          "path": "/",
          "text_contains": "<html"
        }
      ]
    }
  ],
  "command_timeout": 750,
  "python_executable": "python3.11"
}
